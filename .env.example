# Market Intelligence Scraper — Environment Configuration Template

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/market_intelligence

# Redis
REDIS_URL=redis://localhost:6379/0

# Proxy Configuration
PROXY_LIST=http://proxy1.example.com:8080,http://proxy2.example.com:8080
PROXY_TIER=rotating_residential

# Webhook Delivery
WEBHOOK_ENDPOINT=https://your-downstream-service.com/ingest
WEBHOOK_SECRET=your_hmac_secret_here

# Scraper Settings
REQUEST_TIMEOUT=30
MAX_RETRIES=5
BACKOFF_FACTOR=2.0
HEADLESS_FALLBACK=true

# Service
API_HOST=0.0.0.0
API_PORT=8010
LOG_LEVEL=INFO
